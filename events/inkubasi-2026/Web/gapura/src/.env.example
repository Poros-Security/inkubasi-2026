# Nilai yang dibaca docker-compose.yml. Salin ke .env lalu sesuaikan.
# .env asli milik author tidak pernah di-commit (lihat .gitignore),
# jadi tanpa file ini DB_ACCESS_HOST kosong dan phpinfo tidak membocorkan
# host DB -- chall jadi tidak bisa diselesaikan.

# Host DB yang DILIHAT PESERTA di /phpinfo.php. Harus alamat yang
# benar-benar bisa mereka jangkau dari luar, bukan "db".
DB_ACCESS_HOST=CHANGEME.example.com

# Port MariaDB yang dipublish ke peserta.
DB_PORT=13306

# Port web.
WEB_PORT=18080

# Flag. Kalau dikosongkan, db/docker-entrypoint.sh pakai default
# yang sama dengan flagTemplate di challenge.yml.
# Samakan dengan flagTemplate di ../challenge.yml
FLAG=

MARIADB_ROOT_PASSWORD=rootpass
